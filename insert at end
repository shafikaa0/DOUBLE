void insertAtEnd()
{
    struct node *newnode, *temp;

    newnode = (struct node*)malloc(sizeof(struct node));

    printf("Enter data: ");
    scanf("%d", &newnode->data);

    newnode->next = NULL;

    if(header == NULL)
    {
        newnode->prev = NULL;
        header = newnode;
    }
    else
    {
        temp = header;

        while(temp->next != NULL)
        {
            temp = temp->next;
        }

        temp->next = newnode;
        newnode->prev = temp;
    }

    printf("Node inserted at end.\n");
}
